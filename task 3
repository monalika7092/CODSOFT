from tkinter import *
from tkinter import messagebox
import random
import string

root = Tk()
root.title("Password Generator")
root.geometry("550x400")
root.config(bg="#1E1E2F")
root.resizable(False, False)

# ---------- Functions ----------

def generate_password():
    try:
        length = int(length_entry.get())

        if length < 4:
            messagebox.showwarning(
                "Warning",
                "Password length should be at least 4"
            )
            return

        chars = (
            string.ascii_letters +
            string.digits +
            string.punctuation
        )

        password = ''.join(
            random.choice(chars)
            for _ in range(length)
        )

        password_entry.delete(0, END)
        password_entry.insert(0, password)

    except:
        messagebox.showerror(
            "Error",
            "Enter a valid password length"
        )


def accept_password():
    if password_entry.get() == "":
        messagebox.showwarning(
            "Warning",
            "Generate password first"
        )
    else:
        messagebox.showinfo(
            "Success",
            "Password Accepted!"
        )


def reset_fields():
    username_entry.delete(0, END)
    length_entry.delete(0, END)
    password_entry.delete(0, END)

# ---------- Heading ----------

Label(
    root,
    text="PASSWORD GENERATOR",
    font=("Arial", 24, "bold"),
    bg="#1E1E2F",
    fg="#00E5FF"
).pack(pady=20)

# ---------- Main Frame ----------

frame = Frame(root, bg="#2A2A40")
frame.pack(padx=20, pady=10, fill="both", expand=True)

# Username

Label(
    frame,
    text="Enter User Name:",
    font=("Arial", 12, "bold"),
    bg="#2A2A40",
    fg="white"
).grid(row=0, column=0, padx=10, pady=15, sticky="w")

username_entry = Entry(
    frame,
    font=("Arial", 12),
    width=25
)
username_entry.grid(row=0, column=1, pady=15)

# Password Length

Label(
    frame,
    text="Password Length:",
    font=("Arial", 12, "bold"),
    bg="#2A2A40",
    fg="white"
).grid(row=1, column=0, padx=10, pady=15, sticky="w")

length_entry = Entry(
    frame,
    font=("Arial", 12),
    width=25
)
length_entry.grid(row=1, column=1)

# Generated Password

Label(
    frame,
    text="Generated Password:",
    font=("Arial", 12, "bold"),
    bg="#2A2A40",
    fg="white"
).grid(row=2, column=0, padx=10, pady=15, sticky="w")

password_entry = Entry(
    frame,
    font=("Arial", 12),
    width=25
)
password_entry.grid(row=2, column=1)

# Generate Button

Button(
    frame,
    text="GENERATE PASSWORD",
    font=("Arial", 12, "bold"),
    bg="#00C853",
    fg="white",
    width=22,
    command=generate_password
).grid(row=3, column=0, columnspan=2, pady=20)

# Accept Button

Button(
    frame,
    text="ACCEPT",
    font=("Arial", 11, "bold"),
    bg="#2979FF",
    fg="white",
    width=12,
    command=accept_password
).grid(row=4, column=0, pady=10)

# Reset Button

Button(
    frame,
    text="RESET",
    font=("Arial", 11, "bold"),
    bg="#FF5252",
    fg="white",
    width=12,
    command=reset_fields
).grid(row=4, column=1, pady=10)

root.mainloop()
